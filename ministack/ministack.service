# Instalado em /etc/systemd/system/ministack.service.
# Troque `batata` abaixo pelo usuário local que deve ser dono do processo
# (tanto a instalação via pipx quanto o diretório de estado persistido
# dependem de $HOME).
[Unit]
Description=Emulador local de AWS MiniStack
After=network-online.target

[Service]
User=batata
Environment=GATEWAY_PORT=4566
Environment=PERSIST_STATE=1
Environment=MINISTACK_REGION=us-east-1
ExecStart=/home/batata/.local/bin/ministack
Restart=on-failure
MemoryMax=128M

[Install]
WantedBy=multi-user.target
